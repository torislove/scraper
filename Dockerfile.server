# ==============================================================================
# Scraper.co.in - Zero-Chromium Polyglot Backend Server (:5002)
# Multi-tenant Sandbox Isolation + Native Go & Python Sidecar Integration
# ==============================================================================

FROM node:20-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    dumb-init \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY extension/ ./extension/
COPY server/package*.json ./server/

WORKDIR /app/server
RUN npm ci --omit=dev && npm cache clean --force

COPY server/ ./
RUN mkdir -p /app/server/data /app/server/db /storage && chmod -R 775 /storage /app/server/data /app/server/db

ENV PORT=5002
ENV SCRAPER_HOST=0.0.0.0
ENV NODE_ENV=production
ENV UV_THREADPOOL_SIZE=8
ENV COMPUTE_MODE=hybrid
ENV TLS_SIDECAR_URL=http://127.0.0.1:5003
ENV STORAGE_ROOT=/storage
ENV SANDBOX_USER_ID=default
ENV FREE_TRIAL_DAYS=7
ENV NODE_OPTIONS="--max-old-space-size=1024"

EXPOSE 5002

HEALTHCHECK --interval=20s --timeout=4s --start-period=10s --retries=3 \
  CMD sh -c 'curl -f http://127.0.0.1:${PORT:-5002}/api/health || exit 1'

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "index.js"]
