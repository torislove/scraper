# ==============================================================================
# Scraper.co.in - Autonomous Residential Edge Scraper (Production)
# Zero-Server Footprint: Client PC Hardware & Browser Extension Powered
# ==============================================================================

FROM node:20-bookworm-slim AS base

# Install essential runtime utilities & minimal shared libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    dumb-init \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy root geo data and metadata
COPY --chown=node:node data/ ./data/

# Copy server package manifests
COPY --chown=node:node server/package*.json ./server/

WORKDIR /app/server

# Install lean production dependencies
RUN npm ci --omit=dev && npm cache clean --force

# Copy pre-packaged zero-knowledge browser extensions & server source
COPY --chown=node:node extension/ ./extension/
COPY --chown=node:node server/ ./

# Create persistent storage directories with proper permissions
RUN mkdir -p /app/server/data /app/server/db/user_sessions && \
    chown -R node:node /app/server/data /app/server/db

# Security: Run as unprivileged node user
USER node

# Production Zero-Server Compute Configuration:
# - All DOM parsing, network transit, and residential scraping run on Client Hardware
# - Cloud server functions as lightweight JSON coordinator (<50MB RAM idle)
ENV PORT=5002
ENV NODE_ENV=production
ENV COMPUTE_MODE=extension_only
ENV SCRAPER_EXTENSION_ONLY=true
ENV USER_RAM_OFFLOAD_ENABLED=1
ENV SCRAPER_ALLOW_REMOTE=1
ENV SCRAPER_BROWSER_SLOTS=0
ENV PLAYWRIGHT_CONCURRENCY=0
ENV NODE_OPTIONS="--max-old-space-size=1024"

EXPOSE 5002

# Health check probe
HEALTHCHECK --interval=20s --timeout=4s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5002/api/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "index.js"]
