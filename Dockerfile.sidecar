# ==============================================================================
# Scraper.co.in - Python Chrome-TLS Sidecar (:5003)
# Powers Google Maps tbm=map RPC, Website Contact Crawl & Dossier Lookup
# ==============================================================================

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/python
RUN pip install --no-cache-dir primp curl_cffi beautifulsoup4 phonenumbers h3 selectolax tldextract dnspython duckdb shapely

COPY server/python/ ./

RUN useradd --create-home --uid 1000 sidecar && chown -R sidecar:sidecar /app/python
USER 1000

EXPOSE 5003

HEALTHCHECK --interval=15s --timeout=4s --start-period=6s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5003/health || exit 1

CMD ["python3", "-u", "tls_engine.py", "5003"]
