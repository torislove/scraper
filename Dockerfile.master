# ==========================================
# Scraper.co.in - Master Admin Console Image
# Multi-stage production build (Vite + Nginx)
# Admin-only territory control room
# ==========================================

# Stage 1: Build Vite React SPA
FROM node:20-alpine AS builder

WORKDIR /app

# Cache dependencies
COPY master/package*.json ./
RUN npm ci

# Copy source and compile production bundle
COPY master/ ./
RUN npm run build

# Stage 2: Minimal Nginx Runtime
FROM nginx:1.27-alpine

# Copy compiled frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy optimized Nginx configuration
COPY deploy/nginx/master.conf /etc/nginx/conf.d/default.conf

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
