// ===== SAFE PROMISE WRAPPER =====
// Wraps async functions to prevent unhandled rejections from crashing the server
async function safeExecute(fn, name = 'Operation') {
  try {
    return await fn();
  } catch (error) {
    console.error(`[SafeExecute] ${name} failed:`, error.message);
    addLog(`[SafeExecute] ${name} failed: ${error.message}`);
    return null;
  }
}

