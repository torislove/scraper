}

// Playwright: Only load if not in production or if ENABLE_PLAYWRIGHT env is set
const PLAYWRIGHT_ENABLED = process.env.ENABLE_PLAYWRIGHT === 'true' || process.env.NODE_ENV !== 'production';
let playwrightExtra = null;
let browserEngines = { chromium: null, firefox: null, webkit: null };
let stealth = null;
// Backward-compat shim: some modules reference `chromium` directly.
let chromium = null;
const activeCronJobs = {};
if (PLAYWRIGHT_ENABLED) {
  try {
    playwrightExtra = require('playwright-extra');
    // expose available browser engines
    browserEngines.chromium = playwrightExtra.chromium;
    // Provide a minimal global shim for legacy code that expects `chromium` variable
    try { global.chromium = browserEngines.chromium; } catch (e) {}
    browserEngines.firefox = playwrightExtra.firefox || null;
    browserEngines.webkit = playwrightExtra.webkit || null;
    // Legacy shim removed; callers should use `browserEngines.chromium` instead

    stealth = require('puppeteer-extra-plugin-stealth')();
    // Attach stealth plugin to available engines
    Object.values(browserEngines).forEach(engine => {
      try { engine && engine.use && engine.use(stealth); } catch(e) {}
    });

    console.log('[Playwright] Browser engine loaded.');
  } catch (e) {
    console.warn('[Playwright] Not available on this server. Scraping will use Cheerio only.');
  }
} else {
  console.log('[Playwright] Disabled in production. Using Cheerio-only scraping.');
}
