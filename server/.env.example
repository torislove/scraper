# Copy to server/.env and fill in. Never commit the real file.
PORT=5002
SCRAPER_HOST=0.0.0.0

# Maps geocoding (Ola Maps). Free tier from https://olamaps.io
OLA_MAPS_API_KEY=

# Optional: LLM-assisted category/location understanding
NVIDIA_API_KEY=

# Desktop-only: refuse scrape requests without a valid licence
# LICENSE_ENFORCE=1
# LICENSE_FILE=%APPDATA%\Scraper\license.json
