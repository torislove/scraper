# ==========================================
# Scraper.co.in - Client Console Image
# Multi-stage Monorepo Build (Vite + @shared + Nginx Template)
# ==========================================

FROM node:20-alpine AS builder
WORKDIR /workspace

COPY shared/ ./shared/
COPY client/package*.json ./client/
WORKDIR /workspace/client
RUN npm ci

COPY client/ ./
RUN npm run build

FROM nginx:1.27-alpine
ENV API_UPSTREAM=http://127.0.0.1:5002
COPY --from=builder /workspace/client/dist /usr/share/nginx/html
COPY deploy/nginx/app.conf.template /etc/nginx/templates/default.conf.template

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
