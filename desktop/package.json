{
  "name": "scraper-desktop",
  "productName": "Scraper",
  "version": "1.0.0",
  "description": "India vendor lead intelligence - desktop edition",
  "author": {
    "name": "scraper.co.in",
    "email": "support@scraper.co.in"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "npm run build:desktop && cross-env ELECTRON_DEV=1 electron .",
    "start": "cross-env ELECTRON_DEV=1 electron .",
    "build:desktop": "npm --prefix ../client run build:desktop",
    "pack": "electron-builder --win --x64 --dir",
    "predist": "npm --prefix ../client run build:desktop",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
