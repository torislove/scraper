{
  "name": "gomandap-scraper",
  "version": "1.0.0",
  "description": "Gomandap Scraper orchestrator",
  "scripts": {
    "start": "node dev.js",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm run dev",
    "start:master": "cd master && npm run dev",
    "dev": "node dev.js",
    "dev:master": "cd master && npm run dev",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build",
    "build:master": "cd master && npm run build",
    "bild": "npm run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install && npm --prefix master install"
  },
  "dependencies": {
    "fuse.js": "^7.4.2"
  }
}
